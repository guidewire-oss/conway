# Conway — canonical task interface. Self-contained: a fresh clone needs only
# this file and a Go toolchain.
#
# Fastest way to try Conway: `docker compose up` (app + Postgres, seeded with
# a small demo org). The targets below are for local Go development against
# a Postgres you already have running (e.g. `docker compose up -d postgres`, which
# publishes 5432 on loopback for this purpose). CONWAY_PG_PORT moves that port and
# DATABASE_URL below follows it, so one variable is enough.
#
# CONWAY_ADMIN_PASSWORD sets the admin password on every boot, so it is also how
# you reset it: `CONWAY_ADMIN_PASSWORD=... make server`.
#
# Everything this Makefile or the server writes at runtime goes under var/ —
# binary, pid, log, and the local JSON store. One directory, one ignore rule.
SHELL := /bin/bash
PORT ?= 8741
APP_DIR := app
VAR := var
BIN := $(VAR)/conway
SERVER_PID := $(VAR)/server.pid
SERVER_LOG := $(VAR)/server.log
STORE := $(VAR)/store.json
# Derived from CONWAY_PG_PORT so the documented workaround actually works: that
# variable moves where the compose Postgres publishes, and this has to follow it
# or `make server` dials a port nothing is listening on.
DATABASE_URL ?= postgres://conway:conway@localhost:$(or $(CONWAY_PG_PORT),5432)/conway?sslmode=disable

.PHONY: help build test guard preflight server stop status logs clean

help: ## Show this help
	@echo "Conway targets:"
	@grep -hE '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) \
	  | awk 'BEGIN{FS=":.*?## "}{printf "  \033[36m%-10s\033[0m %s\n",$$1,$$2}'
	@echo
	@echo "Vars: PORT=$(PORT)  DATABASE_URL=$(DATABASE_URL)  (CONWAY_ADMIN_PASSWORD for 'server')"

$(VAR):
	@mkdir -p $(VAR)

build: | $(VAR) ## Build the Go server binary (var/conway)
	go build -o $(BIN) ./server

test: guard ## Run engine (JS) and server (Go) tests
	node --test 'tests/*.test.mjs'
	go test ./...

guard: ## Check internal paths are still git-ignored (see the hook's header)
	@./scripts/hooks/internal-paths-ignored.sh

preflight: guard ## Pre-push checks: strict guard + the factory gate suite
	@./scripts/hooks/internal-paths-ignored.sh --strict
	./scripts/pre-push-check.sh

# stop before build, in that order: writing var/conway while the old one is still
# executing fails with ETXTBSY on Linux. Sub-makes rather than prerequisites so the
# order holds under `make -j` too.
server: ## Restart the Go server against DATABASE_URL (needs Postgres reachable — see docker-compose.yml)
	@$(MAKE) --no-print-directory -f $(firstword $(MAKEFILE_LIST)) stop
	@$(MAKE) --no-print-directory -f $(firstword $(MAKEFILE_LIST)) build
	@CONWAY_ADDR=:$(PORT) CONWAY_APP_DIR=$(APP_DIR) CONWAY_STORE=$(STORE) DATABASE_URL=$(DATABASE_URL) \
	  nohup $(BIN) >$(SERVER_LOG) 2>&1 & echo $$! >$(SERVER_PID)
	@scripts/wait-for-http.sh http://localhost:$(PORT)/ $$(cat $(SERVER_PID)) $(SERVER_LOG)
	@echo "conway server -> http://localhost:$(PORT)  (pid $$(cat $(SERVER_PID)))"
	@grep -i 'admin password' $(SERVER_LOG) || true

stop: ## Stop the server started by `make server`, and free PORT if anything else holds it
	@if [ -f $(SERVER_PID) ] && kill -0 $$(cat $(SERVER_PID)) 2>/dev/null; then \
	  kill $$(cat $(SERVER_PID)) 2>/dev/null && echo "stopped pid $$(cat $(SERVER_PID))"; \
	elif [ -f $(SERVER_PID) ]; then echo "stale $(SERVER_PID) (pid gone) - removing"; \
	fi; rm -f $(SERVER_PID)
	@sleep 1; if ! command -v lsof >/dev/null 2>&1; then \
	  echo "stop: lsof not found — cannot check whether port $(PORT) is still held; the next build may fail to bind. Install lsof (macOS has it by default)." >&2; \
	else \
	  holder=$$(lsof -nP -tiTCP:$(PORT) -sTCP:LISTEN 2>/dev/null || true); \
	  if [ -n "$$holder" ]; then \
	    echo "port $(PORT) still held by listener pid $$holder - killing it, else the next build cannot bind and the old binary keeps serving"; \
	    kill $$holder 2>/dev/null || true; sleep 1; \
	  fi; \
	fi

status: ## Show whether the server is running
	@if [ -f $(SERVER_PID) ] && kill -0 $$(cat $(SERVER_PID)) 2>/dev/null; then echo "up: $(SERVER_PID) ($$(cat $(SERVER_PID)))"; \
	  else echo "down: $(SERVER_PID)"; fi

logs: ## Tail the server log
	@tail -n 40 -f $(SERVER_LOG)

clean: stop ## Stop and remove everything under var/ (binary, logs, pids, local store)
	@rm -rf $(VAR)
	@echo cleaned
