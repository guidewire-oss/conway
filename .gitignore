# Everything here is produced by this repository's own code or tooling, so it
# applies to every clone. Files that exist only on one maintainer's machine
# live in .git/info/exclude instead — they are not the project's business, and
# listing them here would publish internal names in a public repo.

.claude/
__pycache__/
*.pyc
.DS_Store

# Everything written at runtime — binary, pid, log, local JSON store, game
# state. The Makefile creates it and `make clean` removes it.
var/

# local-only helper scripts and env (the Makefile is the committed interface)
scripts/local/

# real deploy-target env values — source this from .envrc locally; never commit
.envrc.local

# Output of the legacy v1 mining pipeline (data/extract.py + scripts/). Whoever
# runs it against their own Jira generates their own org's data here — keeping
# it ignored stops anyone committing it. The demo/seed dataset lives in
# server/db/seed/ instead.
data/*.jsonl
data/*.json
data/*.txt
data/mining_summary.md


# real deploy-target env values — source this from .envrc locally; never commit
.envrc.local

# JetBrains IDE project files
.idea/

# Local-only (never tracked)
.claude/settings.local.json
.env

# Factory runtime state (gate-block event log for `factory report`)
.factory/

# Go
*.test
*.out

# OS
.DS_Store

# Node
node_modules/

# Eval results — track baselines, ignore current-run (regenerated each time)
eval/results/*-current.json
eval/results/current-run.json
eval/results/last-run.json
# Mock-runner results are self-test artifacts, never real baselines
eval/results/mock-*.json

# Wiki is agent-maintained but tracked (lint-gated at merge)
# wiki/ is NOT ignored — it's committed and reviewed

# Memory/lessons are tracked (one lesson per file, committed)
# memory/lessons/ is NOT ignored

# Loop-close flag files (transient, per-session — never tracked)
memory/.pending-lesson-reminder
memory/PENDING-LESSONS.md
memory/.parity-stale

# Claude config is GENERATED from opencode.json — tracked for drift check
# .claude/ and .mcp.json are committed (not ignored)
# Exception: .claude/settings.local.json is local-only (above)

# Factory config (generated by factory-init — track it)
# factory.yaml is committed

# factory-init/upgrade write these when they overwrite a file we own.
# Useful to re-merge from, never to commit.
*.factory-backup.*
