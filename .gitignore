# Everything here is produced by this repository's own code or tooling, so it
# applies to every clone. Files that exist only on one maintainer's machine
# live in .git/info/exclude instead — they are not the project's business, and
# listing them here would publish internal names in a public repo.

.claude/
__pycache__/
*.pyc
.DS_Store

# Everything written at runtime — binary, pid, log, local JSON store, game
# state. The Makefile creates it and `make clean` removes it.
var/

# local-only helper scripts and env (the Makefile is the committed interface)
scripts/local/

# real deploy-target env values — source this from .envrc locally; never commit
.envrc.local

# Output of the legacy v1 mining pipeline (data/extract.py + scripts/). Whoever
# runs it against their own Jira generates their own org's data here — keeping
# it ignored stops anyone committing it. The demo/seed dataset lives in
# server/db/seed/ instead.
data/*.jsonl
data/*.json
data/*.txt
data/mining_summary.md

# real deploy-target env values — source this from .envrc locally; never commit
.envrc.local

# JetBrains IDE project files
.idea/
