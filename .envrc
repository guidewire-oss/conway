export CONWAY_ADMIN_PASSWORD=pickone
export NS=conway

# Uncomment and fill in for deploys (or pass on the command line):
# export AWS_REGION=us-west-2
# export ECR_REGISTRY=<acct>.dkr.ecr.us-west-2.amazonaws.com
# export REPO=conway
# export NS_LABELS="<your platform's required governance labels, if any>"
# export PUBLIC_URL=<your deployed URL, for the deploy.sh summary>
# export CONWAY_PUBLIC_URL=<your deployed URL, for the OAuth redirect>
# export CONWAY_JIRA_BASE_URL=<your Jira base URL, for "view in Jira" links>
# export CONWAY_JIRA_SITE_HINT=<substring to prefer among your OAuth-accessible Jira sites>

# Real values for this fork's actual internal deploy target belong in a
# gitignored local override (e.g. .envrc.local, sourced by your shell config
# or direnv's source_env) — never in this tracked file.
